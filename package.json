{
  "name": "bootwatch",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "build:all": "eas build --platform all --profile production",
    "submit:ios": "eas submit --platform ios --latest",
    "submit:android": "eas submit --platform android --latest",
    "ota": "eas update --branch production --environment production",
    "ota:preview": "eas update --branch preview --environment preview",
    "verify:storage": "node scripts/verify-storage-policies.mjs",
    "supabase:vanity:check": "npx supabase vanity-subdomains check-availability --experimental --desired-subdomain bootwatch",
    "supabase:vanity:activate": "npx supabase vanity-subdomains activate --experimental --desired-subdomain bootwatch"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo/metro-runtime": "~55.0.6",
    "@expo/vector-icons": "^15.0.2",
    "@googlemaps/js-api-loader": "^1.16.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "2.99.0",
    "expo": "~55.0.5",
    "expo-apple-authentication": "~55.0.9",
    "expo-auth-session": "~55.0.9",
    "expo-blur": "~55.0.10",
    "expo-constants": "~55.0.7",
    "expo-crypto": "~55.0.10",
    "expo-device": "~55.0.9",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.9",
    "expo-image": "~55.0.8",
    "expo-image-picker": "~55.0.11",
    "expo-linear-gradient": "~55.0.9",
    "expo-location": "~55.1.2",
    "expo-notifications": "~55.0.11",
    "expo-status-bar": "~55.0.4",
    "expo-updates": "~55.0.21",
    "expo-web-browser": "~55.0.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/google.maps": "^3.58.1",
    "@types/react": "~19.2.2",
    "supabase": "^2.116.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
