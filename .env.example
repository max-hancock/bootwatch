# Template only — NO VALUES IN THIS FILE. This repo is public.
# Copy to `.env` (gitignored) and fill in from the Supabase / Google Cloud dashboards.
#
# Local `.env` must point at the DEV Supabase project, never production.
# `npm start` reads `.env` directly, so production values here mean your test
# reports hit real users and fire real push notifications.
#
# Release builds do NOT read this file. They read EAS environment variables,
# scoped per build profile (see eas.json):
#
#   development / development-device  -> environment: development  -> DEV project
#   preview                           -> environment: preview      -> DEV project
#   beta (TestFlight)                 -> environment: preview      -> DEV project
#   production (App Store)            -> environment: production   -> PROD project
#
# Manage those with `eas env:list` / `eas env:create`, or the EAS dashboard.

# Supabase project origin, e.g. https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key. Safe to ship (RLS enforces access), but still
# scoped per project — the dev key must not be the production key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps JS API key, web only (src/components/WebMap.tsx).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Maps key injected into the native Android config (app.config.js).
# Not EXPO_PUBLIC_ on purpose: build-time only, not referenced from app code.
GOOGLE_MAPS_API_KEY=

# Optional feature flag: forces the timer mascot on/off. Unset means on in dev,
# off in release (src/config/features.ts). See docs/FEATURE_FLAGS.md.
EXPO_PUBLIC_SHOW_MASCOT=
